#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY_L   0
#define COLEMK_L   1
#define MEDIA_L    2
#define NAV_L      3
#define MOUSE_L    4
#define SYM_L      5
#define NUM_L      6
#define FUN_L      7
#define FUN2_L     8
#define QFLAT_L    9
#define SHIFT_L   10
#define TOUHOU_L  11

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
/* QWERTY
 * --------------------------------------------------------------------------------------------------------------------------------------
 * |       |   Q   |   W   |   E   |   R   |   T   |------------------------------------ |   Y   |   U   |   I   |   O   |   P   |       |
 * |       |   A   |   S   |   D   |   F   |   G   |-------------------------------------|   H   |   J   |   K   |   L   |   ;   |       |
 * |       |   Z   |   X   |   C   |   V   |   B   |  XXX  |---------------------|  XXX  |   N   |   M   |   ,   |   .   |   /   |       |
 *                                 |  XXX  |  ESC  |  SPC  | TAB   |-----|  RET  |  BSPC |  DEL  | CMENU |
 */
                        bindings = <
&none    &kp  Q        &kp  W        &kp  E        &kp  R        &kp  T                                                                         &kp  Y        &kp  U        &kp  I        &kp  O        &kp  P        &none
&none    &mt LGUI A    &mt LALT S    &mt LCTRL D   &mt LSHFT F   &kp  G                                                                         &kp  H        &mt LSHFT J   &mt LCTRL K   &mt LALT L    &mt LGUI SEMI &none
&none    &kp  Z        &mt RALT X    &kp  C        &kp  V        &kp  B        &none                                              &none         &kp  N        &kp  M        &kp  COMMA    &mt RALT DOT  &kp  SLASH    &none
                                                   &none         &lt 2 ESC     &lt 3 SPACE   &lt 4 TAB              &lt 5 RET     &lt 6 BSPC    &lt 7 DEL     &lt 8 K_CMENU
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                colemak_layer {
/* COLEMAK-DH
 * ---------------------------------------------------------------------------------------------------------------------------------------
 * |       |   Q   |   W   |   F   |   P   |   B   |--------------------------------------|   J   |   L   |   U   |   Y   |   ;   |       |
 * |       |   A   |   R   |   S   |   T   |   G   |--------------------------------------|   M   |   N   |   E   |   I   |   O   |       |
 * |       |   Z   |   X   |   C   |   D   |   V   |  XXX  |----------------------|  XXX  |   K   |   H   |   ,   |   .   |   /   |       |
 *                                 |  XXX  |  ESC  |  SPC  | TAB   |------|  RET  |  BSPC |  DEL  |  XXX  |
 */
                        bindings = <
&none    &kp  Q        &kp  W        &kp  F        &kp  P        &kp  B                                                                         &kp  J        &kp  L        &kp  U        &kp  Y        &kp  SQT      &none
&none    &mt LGUI A    &mt LALT R    &mt LCTRL S   &mt LSHFT T   &kp  G                                                                         &kp  M        &mt LSHFT N   &mt LCTRL E   &mt LALT I    &mt LGUI O    &none
&none    &kp  Z        &mt RALT X    &kp  C        &kp  D        &kp  V        &none                                              &none         &kp  K        &kp  H        &kp  COMMA    &mt RALT DOT  &kp  SLASH    &none
                                                   &none         &lt 2 ESC     &lt 3 SPACE   &lt 4 TAB              &lt 5 RET     &lt 6 BSPC    &lt 7 DEL     &lt 8 K_CMENU
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                media_layer {
/* MEDIA
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| COLEMK| L_FLAT | L_SHFT| LTH |-----------------------------------|       |       | VOLU  |       |       |       |
 * |       | LGUI  | LALT  | LCTRL | LSHFT |      |-----------------------------------|       | PREV  | VOLD  | NEXT  |       |      |
 * |       |       | RALT  |       |       |      |       |-------------------| BT_CLR| BT_TG | BT 0  | BT 1  | BT 2  | BT 3  |      |
 *                                 |       |      |       |       |---|       | STOP  | PPLAY | MUTE  |
 */
                        bindings = <
&none         &to QWERTY_L &to COLEMK_L &to QFLAT_L   &to SHIFT_L &to TOUHOU_L                                                            &none        &none         &kp C_VOL_UP  &none         &none        &none
&none         &kp LGUI     &kp  LALT    &kp  LCTRL    &kp LSHFT   &none                                                                   &none        &kp C_PREV    &kp C_VOL_DN  &kp C_NEXT    &none        &none
&none         &none        &kp  RALT    &none         &none       &none         &none                                        &bt BT_CLR   &out OUT_TOG &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &none
                                                      &none       &trans        &none       &none                &kp C_STOP  &kp C_PP     &kp C_MUTE   &none
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                nav_layer {
/* NAV
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| COLEMK| L_FLAT | L_SHFT| LTH |-----------------------------------| INSERT| HOME  | UP    | END   | PG_UP |       |
 * |       | LGUI  | LALT  | LCTRL | LSHFT |      |-----------------------------------| CAPSW | LEFT  | DOWN  | RIGHT | PG_DN |      |
 * |       |       | RALT  |       |       |      |       |-------------------| CAPSL | Undo  | Cut   | Copy  | Paste | Redo  |      |
 *                                 |       |      |       |       |---|       | RET   | BSPC  | DEL   |
 */
                        bindings = <
&none         &to QWERTY_L &to COLEMK_L &to QFLAT_L   &to SHIFT_L &to TOUHOU_L                                                     &kp INS     &kp HOME    &kp UP    &kp END       &kp PG_UP  &none
&none         &kp LGUI     &kp  LALT    &kp  LCTRL    &kp LSHFT   &none                                                            &caps_word  &kp LEFT    &kp DOWN  &kp RIGHT     &kp PG_DN  &none
&none         &none        &kp  RALT    &none         &none       &none         &none                                    &kp CAPS  &kp LC(Z)   &kp LC(X)   &kp LC(C) &kp LC(V)     &kp LC(Y)   &none
                                                      &trans       &none        &trans       &none           &kp RET     &kp BSPC   &kp DEL   &none
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                mouse_layer {
/* NAV
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| COLEMK| L_FLAT | L_SHFT| LTH |-----------------------------------|       | WHL_L | MUP   | WHL_L | WHL_UP |      |
 * |       | LGUI  | LALT  | LCTRL | LSHFT |      |-----------------------------------|       | MLEFT | MDOWN | MRIGHT| WHL_DN |      |
 * |       |       | RALT  |       |       |      |       |-------------------|       | Undo  | Cut   | Copy  | Paste | Redo   |      |
 *                                 |       |      |       |       |---|       | MCLK  | LCLK  | RCLK  |
 */
                        bindings = <
&none         &to QWERTY_L &to COLEMK_L &to QFLAT_L   &to SHIFT_L &to TOUHOU_L                                                            &none       &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT    &msc SCRL_UP    &none
&none         &kp LGUI     &kp  LALT    &kp  LCTRL    &kp LSHFT   &none                                                                   &none       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT    &msc SCRL_DOWN  &none
&none         &none        &kp  RALT    &none         &none       &none         &none                                      &none          &kp LC(Z)   &kp LC(X)      &kp LC(C)      &kp LC(V)          &kp LC(Y)       &none
                                                      &none       &none         &none       &trans          &mkp MCLK      &mkp LCLK      &mkp RCLK   &none
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                sym_layer {
/* SYM
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |      |   {   |   &   |   *   |   (   |   }   |-----------------------------------|       |       |       |       |       |       |
 * |      |   :   |   $   |   %   |   ^   |   +   |-----------------------------------|       | Shift | Ctrl  | Alt   | Gui   |       |
 * |      |   ~   |   !   |   @   |   #   |   |   |       |-------------------|       |       |       |       |       |       |       |
 *                                |   (   |   )   |   _   |        |---|      |       |       |       |
 */
                        bindings = <
&none     &kp LBRC     &kp AMPS    &kp STAR     &kp LPAR     &kp RBRC                                                                &kp LANG_ZENKAKUHANKAKU &kp INT_MUHENKAN  &kp INT_KANA  &kp INT_HENKAN &kp INT_KPJPCOMMA  &none
&none     &kp COLON    &kp DLLR    &kp PRCNT    &kp CARET    &kp PLUS                                                                &none                &kp LSHFT      &kp LCTRL  &kp LALT    &kp LGUI        &none
&none     &kp TILDE    &kp EXCL    &kp AT       &kp HASH     &kp PIPE     &none                                          &none       &none                &none          &none      &kp RALT    &none           &none
                                                &none      &kp LPAR     &kp RPAR       &kp UNDER             &trans      &none       &none                &none
                        >;

                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                num_layer {
/* NUM
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |      |   [   |   7   |   8   |   9   |   ]   |-----------------------------------|       |       |       |       |       |       |
 * |      |   ;   |   4   |   5   |   6   |   =   |-----------------------------------|       | Shift | Ctrl  | Alt   | Gui   |       |
 * |      |   `   |   1   |   2   |   3   |   \   |       |-------------------|       |       |       |       |       |       |       |
 *                                |   .   |   0   |   -   |        |---|      |       |       |       |
 */
                        bindings = <
&none     &kp LBKT     &kp N7      &kp N8       &kp N9     &kp RBKT                                                                &kp LANG_ZENKAKUHANKAKU &kp INT_MUHENKAN  &kp INT_KANA  &kp INT_HENKAN &kp INT_KPJPCOMMA  &none
&none     &kp SEMI     &kp N4      &kp N5       &kp N6     &kp EQUAL                                                               &none                &kp LSHFT      &kp LCTRL  &kp LALT    &kp LGUI        &none
&none     &kp GRAVE    &kp N1      &kp N2       &kp N3     &kp BSLH     &none                                          &none       &none                &none          &none      &kp RALT    &none           &none
                                                &none      &kp LPAR     &kp N0         &kp MINUS           &none       &trans      &none        &none
                        >;

                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                fun_layer {
/* FUN
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |      |  F12  |  F7   |  F8   |  F9   | PRCNT |-----------------------------------|       |       |       |       |       |       |
 * |      |  F11  |  F4   |  F5   |  F6   | SCRLL |-----------------------------------|       | Shift | Ctrl  | Alt   | Gui   |       |
 * |      |  F10  |  F1   |  F2   |  F3   | PAUSE |       |-------------------|       |       |       |       |       |       |       |
 *                                |   .   |   0   |   -   |        |---|      |       |       |       |
 */
                        bindings = <
&none     &kp F12    &kp F7      &kp F8       &kp F9     &kp PSCRN                                                              &kp LANG_ZENKAKUHANKAKU &kp INT_MUHENKAN  &kp INT_KANA  &kp INT_HENKAN &kp INT_KPJPCOMMA  &none
&none     &kp F11    &kp F4      &kp F5       &kp F6     &kp SLCK                                                               &none                &kp LSHFT      &kp LCTRL  &kp LALT    &kp LGUI        &none
&none     &kp F10    &kp F1      &kp F2       &kp F3     &kp PAUSE_BREAK &none                                      &none       &none                &none          &none      &kp RALT    &none           &none
                                              &none      &kp ESC         &kp SPACE      &kp TAB         &none       &none       &trans     &none
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                fun2_layer {
/* FUN
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |      |  F24  |  F19  |  F20  |  F21  | PRCNT |-----------------------------------|       |       |       |       |       |       |
 * |      |  F23  |  F16  |  F17  |  F18  | SCRLL |-----------------------------------|       | Shift | Ctrl  | Alt   | Gui   |       |
 * |      |  F22  |  F13  |  F14  |  F15  | PAUSE |       |-------------------|       |       |       |       |       |       |       |
 *                                |   .   |   0   |   -   |        |---|      |       |       |       |
 */
                        bindings = <
&none     &kp F24    &kp F19     &kp F20      &kp F21    &kp PSCRN                                                              &none      &none      &none      &none      &none      &none
&none     &kp F23    &kp F16     &kp F17      &kp F18    &kp SLCK                                                               &none      &kp LSHFT  &kp LCTRL  &kp LALT   &kp LGUI   &none
&none     &kp F22    &kp F13     &kp F14      &kp F15    &kp PAUSE_BREAK &none                                      &none       &none      &none      &none      &kp RALT   &none      &none
                                              &none      &kp ESC         &kp SPACE      &kp TAB         &none       &none       &none      &trans
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                flat_layer {
/* FLAT QWERTY
 * --------------------------------------------------------------------------------------------------------------------------------------
 * |       |   Q   |   W   |   E   |   R   |   T   |------------------------------------ |   Y   |   U   |   I   |   O   |   P   |       |
 * |       |   A   |   S   |   D   |   F   |   G   |-------------------------------------|   H   |   J   |   K   |   L   |   ;   |       |
 * |       |   Z   |   X   |   C   |   V   |   B   |  XXX  |---------------------|  XXX  |   N   |   M   |   ,   |   .   |   /   |       |
 *                                 |  XXX  |  ESC  |  SPC  | TAB   |-----|  RET  |  BSPC |  DEL  | CMENU |
 */
                        bindings = <
&none    &kp Q    &kp W    &kp E    &kp  R    &kp  T                                                                          &kp  Y    &kp U     &kp I    &kp O    &kp P    &none
&none    &kp A    &kp S    &kp D    &kp  F    &kp  G                                                                          &kp  H    &kp J     &kp K    &kp L    &kp SEMI &none
&none    &kp Z    &kp X    &kp C    &kp  V    &kp  B      &none                                            &none    &kp  N    &kp  M    &kp COMMA &kp DOT  &kp  SLASH    &none
                                              &lt 3 SPACE &kp ESC    &kp SPACE    &kp TAB         &kp RET    &kp BSPC &kp DEL   &none
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                shift_layer {
/* SHIFTED QWERTY
 * --------------------------------------------------------------------------------------------------------------------------------------
 * |       |   `   |   Q   |   W   |   E   |   R   |------------------------------------ |   Y   |   U   |   I   |   O   |   P   |       |
 * |       |  CTRL |   A   |   S   |   D   |   F   |-------------------------------------|   H   |   J   |   K   |   L   |   ;   |       |
 * |       | SHIFT |   Z   |   X   |   C   |   V   |  XXX  |---------------------|  XXX  |   N   |   M   |   ,   |   .   |   /   |       |
 *                                 |  XXX  |  ESC  |  SPC  | TAB   |-----|  RET  |  BSPC |  DEL  | CMENU |
 */
                        bindings = <
&none    &kp GRAVE &kp Q    &kp W    &kp E    &kp  R                                                                          &kp  Y    &kp U     &kp I    &kp O    &kp P    &none
&none    &kp LCTRL &kp A    &kp S    &kp D    &kp  F                                                                          &kp  H    &kp J     &kp K    &kp L    &kp SEMI &none
&none    &kp LSHFT &kp Z    &kp X    &kp C    &kp  V       &none                                             &none    &kp  N  &kp  M    &kp COMMA &kp DOT  &kp  SLASH    &none
                                              &lt 3 SPACE &kp ESC    &kp SPACE    &kp TAB         &kp RET    &kp BSPC &kp DEL &none
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                touhou_layer {
/* FLAT QWERTY
 * --------------------------------------------------------------------------------------------------------------------------------------
 * |       |   Q   |   W   |   E   |   R   |   T   |------------------------------------ |   Y   |   U   |   I   |   O   |   P   |       |
 * |       |   A   |   S   |   D   |   F   |   G   |-------------------------------------|   H   |   J   |   K   |   L   |   ;   |       |
 * |       |   Z   |   X   |   C   |   V   |   B   |  XXX  |---------------------|  XXX  |   N   |   M   |   ,   |   .   |   /   |       |
 *                                 |  XXX  |  ESC  |  SPC  | TAB   |-----|  RET  |  BSPC |  DEL  | CMENU |
 */
                        bindings = <
&none    &kp Q     &kp W     &kp E     &kp  R      &kp  T                                                                          &kp  Y    &kp U     &kp UP   &kp O    &kp P    &none
&none    &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT   &kp  G                                                                          &kp  H    &kp RIGHT &kp DOWN &kp LEFT &kp SEMI &none
&none    &kp Z     &kp X     &kp C     &kp  V      &kp  B      &none                                            &none    &kp  N    &kp  M    &kp COMMA &kp DOT  &kp  SLASH    &none
                                       &lt 3 SPACE &kp ESC     &kp SPACE    &kp TAB         &kp RET    &kp BSPC &kp DEL   &none
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
        };
};
